# Screener.in login credentials
SCREENER_EMAIL=you@example.com
SCREENER_PASSWORD=changeme

# Where state/output/session files live. Locally this is ./data.
# On Railway this should be the mounted Volume path, e.g. /app/data
DATA_DIR=./data

# Optional overrides (all derived from DATA_DIR if unset)
# WATCHLIST_PATH=./data/watchlist.json
# STATE_PATH=./data/state.json
# OUTPUT_PATH=./data/output.json
# STORAGE_STATE_PATH=./data/storage_state.json

# Polite delay between stock page visits (seconds)
MIN_DELAY_SECONDS=3
MAX_DELAY_SECONDS=7

# Retries per stock before giving up (in addition to the first attempt)
MAX_RETRIES_PER_STOCK=2

# Run Chromium headless (set to false only for local debugging)
HEADLESS=true

# Cron expression (5-field, crontab syntax) for the internal scheduler
SCRAPE_CRON=0 3 * * *

# CORS origins allowed to call GET /output. Comma-separated, or * for any.
ALLOWED_ORIGINS=*

# Shared secret required (as X-Run-Token header) to call POST /run-now
RUN_NOW_TOKEN=changeme-too

LOG_LEVEL=INFO
