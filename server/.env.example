# MySQL connection - from your Aiven service overview page (or any MySQL
# host). Aiven's default database is "defaultdb" and requires SSL.
DATABASE_URL=mysql://user:password@host:port/defaultdb?ssl-mode=REQUIRED

# Comma-separated list of origins allowed to call this API (your GitHub
# Pages URL). Use * only for local development.
ALLOWED_ORIGINS=https://sakethfuture.github.io

PORT=3000
